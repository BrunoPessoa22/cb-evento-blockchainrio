# Resend — empty locally means confirmation emails no-op with a console warning
RESEND_API_KEY=
RESEND_FROM_EMAIL=Cultura Builder <cafe@culturabuilder.com>
# Long random string; gates /admin and /api/admin/registrations
ADMIN_SECRET=
NEXT_PUBLIC_SITE_URL=https://evento.culturabuilder.com
# SQLite file location; the Dockerfile overrides this to /app/data/registrations.db
DB_PATH=./data/registrations.db
